---
/* AddressBlock — the first thing typed onto the form under the red rule,
 * set like the addressee on the parcel label: faded typewriter caps, each
 * line stepped further right than the last.
 * Reads: --font-data, --color-text-muted.
 */
import { staggerLines } from './text';

export interface Props { text: string; lines?: number }
const { text, lines = 2 } = Astro.props;
const rows = staggerLines(text, lines);
---

<p class="lb-addr">
  {rows.map((r, i) => <span class="lb-addr__line ink-typewriter" style={`--i:${i}`}>{r}</span>)}
</p>

<style>
  .lb-addr {
    --step: clamp(1.4rem, 5vw, 3.2rem);
    margin: clamp(2.2rem, 6vw, 3.4rem) 0 0 clamp(0rem, 6vw, 4.5rem);
    font-family: var(--font-data);
    font-size: clamp(1.05rem, 2.6vw, 1.35rem);
    line-height: 1.85;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .lb-addr__line { display: block; padding-left: calc(var(--step) * var(--i)); }
</style>
