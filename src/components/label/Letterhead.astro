---
/* Letterhead — the printed zone of the label, then the one red hairline rule.
 *
 *   mandatory ventures                                 (stamp, cropped)
 *   [mark]   MAN•DA•TO•RY  ADJ.  SO IMPORTANT IT IS REQUIRED.
 *            coordinating capital into the world's most important companies.
 *   ─────────────────────────── red rule ───────────────────────────────
 *
 * Name and promise: lowercase italic serif. Hard facts: one line of small,
 * widely spaced geometric caps. `compact` drops the mark and the promise for
 * inner pages (the name links home instead).
 * Reads: --font-display, --font-eyebrow, --color-text, --color-text-muted,
 *        --color-rule, --page-gutter.
 */
import LabelMark from './LabelMark.astro';
import PostalStamp from './PostalStamp.astro';
import { BRAND, DEFINITION } from '@lib/site';

export interface Props {
  compact?: boolean;
  homeHref?: string;
}
const { compact = false, homeHref = '/label/' } = Astro.props;
---

<header class:list={['lb-head', { 'lb-head--compact': compact }]}>
  <div class="lb-head__sheet">
    <div class="lb-head__stamp"><PostalStamp /></div>

    {compact ? (
      <p class="lb-head__name"><a href={homeHref}>{BRAND.name}</a></p>
    ) : (
      <>
        <h1 class="lb-head__name">{BRAND.name}</h1>
        <div class="lb-head__grid">
          <div class="lb-head__mark"><LabelMark /></div>
          <p class="lb-head__facts">
            <span>{DEFINITION.word}</span>
            <span>{DEFINITION.part}</span>
            <span>{DEFINITION.sense}</span>
          </p>
          <p class="lb-head__promise">{BRAND.hero}</p>
        </div>
      </>
    )}
  </div>
  <hr class="lb-head__rule" />
</header>

<style>
  .lb-head { position: relative; overflow: hidden; padding-top: clamp(2.5rem, 7vw, 4.5rem); }
  .lb-head__sheet {
    position: relative;
    max-width: calc(var(--page-measure) + 14rem);
    margin: 0 auto;
    padding: 0 var(--page-gutter);
  }

  /* The cancellation, crooked and cropped by the top of the sheet. */
  .lb-head__stamp {
    position: absolute;
    top: clamp(-8rem, -10vw, -5.5rem);
    right: clamp(-2.5rem, 2vw, 3rem);
    width: clamp(9rem, 26vw, 15rem);
    opacity: 0.42;
    transform: rotate(-9deg);
    pointer-events: none;
  }

  .lb-head__name {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.35rem, 3.2vw, 1.75rem);
    line-height: 1.1;
    letter-spacing: 0.005em;
    text-transform: lowercase;
    color: var(--color-text);
    position: relative;
  }
  .lb-head__name a { color: inherit; text-decoration: none; }
  .lb-head__name a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }

  .lb-head__grid {
    display: grid;
    grid-template-columns: clamp(5.5rem, 13vw, 7.5rem) minmax(0, 1fr);
    grid-template-rows: 1fr auto;
    column-gap: clamp(0.9rem, 2.5vw, 1.6rem);
    margin-top: 0.6rem;
    margin-left: clamp(1.5rem, 9vw, 7.5rem);
  }
  .lb-head__mark { grid-row: 1 / span 2; align-self: end; }

  .lb-head__facts {
    align-self: center;
    margin: 1.4rem 0 0.4rem;
    font-family: var(--font-eyebrow);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-text);
    display: flex;
    flex-wrap: wrap;
    column-gap: 2.2em;
    row-gap: 0.4em;
  }

  .lb-head__promise {
    align-self: end;
    margin: 0;
    max-width: 30ch;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.25rem, 2.9vw, 1.65rem);
    line-height: 1.22;
    text-transform: lowercase;
    color: var(--color-text);
  }

  /* ONE red hairline rule across the full width. */
  .lb-head__rule {
    margin: clamp(1.4rem, 3vw, 2rem) 0 0;
    border: 0;
    height: 0;
    border-top: 1.5px solid var(--color-rule);
  }

  .lb-head--compact { padding-top: clamp(2rem, 5vw, 3rem); }
  .lb-head--compact .lb-head__stamp { width: clamp(7rem, 18vw, 10rem); top: clamp(-6rem, -8vw, -4.5rem); }

  @media (max-width: 560px) {
    .lb-head__grid { margin-left: 0; grid-template-columns: 4.75rem minmax(0, 1fr); }
    .lb-head__facts { font-size: 0.6rem; letter-spacing: 0.2em; column-gap: 1.4em; }
  }
</style>
