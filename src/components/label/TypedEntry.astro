---
/* TypedEntry — one section typed onto the form below the red rule.
 *
 *   RE: FROM STARTUP TO SCALEUP.                         (margin: red note)
 *      Large-scale capital doesn't want ...
 *         body, typed smaller and fainter
 *
 * Each line steps right, the loose stagger of a label typed by hand.
 * `indent` shifts the whole entry by a step or two so the page does not set
 * flush like a web column. Slots: default (after the body), `figure` (between
 * lead and body).
 * Reads: --font-body, --color-text, --color-text-muted, --page-measure.
 */
import EditorNote from './EditorNote.astro';
import { paragraphs } from './text';

export interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  lead?: string;
  body?: string;
  note?: string;
  indent?: number;
  noteTilt?: number;
}
const { id, eyebrow, title, lead, body, note, indent = 0, noteTilt } = Astro.props;
const paras = paragraphs(body);
const headingId = `lb-${id}`;
---

<section class="lb-entry" aria-labelledby={headingId} style={`--indent:${indent}`}>
  <div class="lb-entry__typed">
    <h2 id={headingId} class="lb-entry__title">
      {eyebrow && <span class="lb-entry__eyebrow">{eyebrow}</span>}
      {title}
    </h2>
    {lead && <p class="lb-entry__lead">{lead}</p>}
    <slot name="figure" />
    {paras.length > 0 && (
      <div class="lb-entry__body">
        {paras.map((p) => <p>{p}</p>)}
      </div>
    )}
    <slot />
  </div>
  {note && (
    <div class="lb-entry__margin">
      <EditorNote text={note} tilt={noteTilt} />
    </div>
  )}
</section>

<style>
  .lb-entry {
    --step: clamp(0.85rem, 3.2vw, 2.1rem);
    display: grid;
    grid-template-columns: minmax(0, var(--page-measure)) minmax(0, 12rem);
    column-gap: clamp(1.5rem, 4vw, 3rem);
    margin-top: clamp(3.5rem, 9vw, 6rem);
    padding-left: calc(var(--step) * var(--indent));
  }
  .lb-entry__typed { min-width: 0; }

  .lb-entry__title {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 1rem;
    line-height: 1.5;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-text);
  }
  .lb-entry__eyebrow { margin-right: 1.1ch; }

  .lb-entry__lead {
    margin: 0.55rem 0 0 var(--step);
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text);
    max-width: 52ch;
  }

  .lb-entry__body {
    margin: 0.9rem 0 0 calc(var(--step) * 2);
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    max-width: 56ch;
  }
  .lb-entry__body p { margin: 0 0 0.8em; }

  .lb-entry__margin { padding-top: 0.2rem; }

  @media (max-width: 820px) {
    .lb-entry { grid-template-columns: minmax(0, 1fr); }
    .lb-entry__margin { margin: 1rem 0 0 calc(var(--step) * 3); }
  }
</style>
