---
/* Registration target, left in by the stripper. Decorative. */
export interface Props { class?: string; size?: number }
const { class: cls = '', size = 26 } = Astro.props;
---
<svg class:list={['pu-reg', cls]} width={size} height={size} viewBox="0 0 26 26" aria-hidden="true" focusable="false">
  <circle cx="13" cy="13" r="7.5" fill="none" stroke="currentColor" stroke-width="1" />
  <circle cx="13" cy="13" r="3.4" fill="currentColor" />
  <path d="M13 0v26M0 13h26" stroke="currentColor" stroke-width="0.8" />
  <path d="M13 9.6v6.8M9.6 13h6.8" class="pu-reg-knock" stroke-width="0.8" />
</svg>
<style>
  .pu-reg { color: var(--color-board-ink); display: block; }
  .pu-reg-knock { stroke: var(--color-background); }
</style>
