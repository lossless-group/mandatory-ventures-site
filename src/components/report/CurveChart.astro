---
/* ============================================================================
 * CurveChart — the curve from the decks, redrawn as a Central Airlines 1958
 * "Five Years Growth" chart with Mandatory's twist: two layers.
 *   1. Typewriter layer: tinted plot field, gridlines, axes, axis labels and
 *      the point keys, set in --font-data, texture .ink-typewriter.
 *   2. Marker layer: the data drawn on top as one felt-tip stroke
 *      (.ink-marker) in --color-marker-blue. Red only for the point being
 *      mocked (the last one), circled in red pen.
 * No numbers are invented: the axes carry no values, only the spine's
 * x/y labels. Points are keyed 1-3; the labels live in the facing ledger.
 * ========================================================================== */
interface Point { at: number; label: string }
interface Props {
  xLabel: string;
  yLabel: string;
  points: readonly Point[];
}
const { xLabel, yLabel, points } = Astro.props;

const W = 600, H = 400;
const L = 64, R = 576, T = 44, B = 334;
const k = 4.4;
const f = (x: number) => (Math.exp(k * x) - 1) / (Math.exp(k) - 1);
const px = (x: number) => L + (R - L) * x;
const py = (x: number) => B - 8 - (B - T - 26) * f(x);

const steps = 64;
const curve = Array.from({ length: steps + 1 }, (_, i) => {
  const x = 0.02 + (0.96 * i) / steps;
  return `${i === 0 ? 'M' : 'L'}${px(x).toFixed(1)} ${py(x).toFixed(1)}`;
}).join(' ');

const grid = [0.2, 0.4, 0.6, 0.8].map((g) => B - (B - T) * g);
const ticks = [0.2, 0.4, 0.6, 0.8].map((t) => px(t));

/* Where each key sits relative to its point. */
const keyOffset = [
  { dx: -4, dy: -34 },
  { dx: -30, dy: -24 },
  { dx: -56, dy: 8 },
];
const desc = points.map((p, i) => `${i + 1}: ${p.label}`).join(' ');
---

<svg
  class="cc"
  viewBox={`0 0 ${W} ${H}`}
  role="img"
  aria-labelledby="cc-title cc-desc"
>
  <title id="cc-title">The curve: slow at first, then a steep climb.</title>
  <desc id="cc-desc">{`${yLabel} against ${xLabel}. ${desc}`}</desc>

  <!-- Typewriter layer -->
  <g class="cc-frame ink-typewriter">
    <rect class="cc-field" x={L} y={T} width={R - L} height={B - T} />
    {grid.map((y) => <line class="cc-grid" x1={L} x2={R} y1={y} y2={y} />)}
    {ticks.map((x) => <line class="cc-axis" x1={x} x2={x} y1={B} y2={B + 7} />)}
    <polyline class="cc-axis" points={`${L},${T - 14} ${L},${B} ${R + 8},${B}`} />
    <polyline class="cc-axis" points={`${L - 5},${T - 4} ${L},${T - 16} ${L + 5},${T - 4}`} />
    <polyline class="cc-axis" points={`${R - 4},${B - 5} ${R + 9},${B} ${R - 4},${B + 5}`} />
  </g>
  <g class="cc-type">
    <text x={L + 12} y={T - 18}>{yLabel}</text>
    <text x={R + 6} y={B + 34} text-anchor="end">{xLabel}</text>
  </g>

  <!-- Marker layer -->
  <path class="cc-line ink-marker" d={curve} />
  {points.map((p, i) => {
    const x = px(p.at), y = py(p.at);
    const o = keyOffset[i] ?? { dx: -20, dy: -20 };
    const last = i === points.length - 1;
    return (
      <g class={last ? 'cc-pt cc-pt--mock' : 'cc-pt'}>
        <circle class="cc-dot ink-marker" cx={x} cy={y} r="7" />
        <line class="cc-lead ink-ballpoint" x1={x + o.dx * 0.25} y1={y + o.dy * 0.35} x2={x + o.dx * 0.75} y2={y + o.dy * 0.75} />
        <text class="cc-key" x={x + o.dx} y={y + o.dy} text-anchor="middle">{i + 1}</text>
        {last && (
          <ellipse class="cc-ring ink-ballpoint" cx={x - 2} cy={y + 2} rx="30" ry="22" transform={`rotate(-14 ${x} ${y})`} />
        )}
      </g>
    );
  })}
</svg>

<style>
  .cc { display: block; width: 100%; height: auto; overflow: visible; }
  .cc-field { fill: var(--color-primary-soft); }
  .cc-grid { stroke: var(--color-background); stroke-width: 2; }
  .cc-axis { stroke: var(--color-text); stroke-width: 1.6; fill: none; }
  .cc-type text, .cc-key {
    font-family: var(--font-data);
    font-size: 17px;
    fill: var(--color-text-muted);
  }
  .cc-key { font-size: 20px; font-weight: 700; fill: var(--color-text); }
  .cc-line {
    fill: none;
    stroke: var(--color-marker-blue);
    stroke-width: 9;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.94;
  }
  .cc-dot { fill: var(--color-marker-blue); }
  .cc-lead { stroke: var(--color-text); stroke-width: 1.2; }
  .cc-pt--mock .cc-key { fill: var(--color-editor-red); }
  .cc-pt--mock .cc-lead { stroke: var(--color-editor-red); }
  .cc-ring { fill: none; stroke: var(--color-editor-red); stroke-width: 2.4; }
</style>
