---
/* ============================================================================
 * Plate — the full-bleed illustration page of a spread (Utah Construction
 * 1963, Central Airlines 1966): one flat ink on toned stock, lots of empty
 * ground, a small caption in extended caps sitting low on the page.
 *   tone="slate"  mid-grey stock (band-2), the Central 1966 silhouette page
 *   tone="paper"  the report's own cream stock (surface), for overprints
 * The illustration goes in the default slot; the caption in `caption`.
 * ========================================================================== */
interface Props { tone?: 'slate' | 'paper'; folio?: number }
const { tone = 'slate', folio } = Astro.props;
---

<figure class:list={['pl', `pl--${tone}`]}>
  {folio !== undefined && <span class="pl-folio" aria-hidden="true">{folio}</span>}
  <div class="pl-art"><slot /></div>
  {Astro.slots.has('caption') && <figcaption class="pl-cap"><slot name="caption" /></figcaption>}
</figure>

<style>
  .pl {
    --pl-ink: var(--color-band-1);
    --pl-cap: var(--color-band-1);
    position: relative;
    margin: 0;
    min-height: clamp(24rem, 62vw, 44rem);
    display: grid;
    grid-template-rows: 1fr auto;
    padding: clamp(1.25rem, 3vw, 2.5rem);
    overflow: hidden;
  }
  .pl--slate { --pl-ground: var(--color-band-2); background: var(--pl-ground); }
  .pl--paper { --pl-ground: var(--color-surface); background: var(--pl-ground); --pl-cap: var(--color-text); }
  :global(html[data-mode="dark"]) .pl--slate { --pl-ink: var(--color-background); --pl-cap: var(--color-text); }

  .pl-folio {
    position: absolute; top: 1rem; left: clamp(1.25rem, 3vw, 2.5rem);
    font-family: var(--font-data); font-size: 0.85rem; color: var(--pl-cap);
  }
  .pl-art { display: grid; place-items: center; min-height: 0; }
  .pl-art :global(svg) { width: 100%; max-height: 34rem; }
  .pl-cap {
    text-align: center;
    color: var(--pl-cap);
    padding-top: 1rem;
  }
</style>
