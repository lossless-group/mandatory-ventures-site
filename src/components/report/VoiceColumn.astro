---
/* ============================================================================
 * VoiceColumn — one column of the two-column letter spread (Central Airlines
 * 1966 president's letter). Audience in spaced caps, who in italic serif, the
 * body in Caslon with a Bodoni initial, and the takeaway as the italic line
 * the reader leaves with, under a short typewriter rule.
 * ========================================================================== */
interface Props { id: string; audience: string; who: string; takeaway: string }
const { id, audience, who, takeaway } = Astro.props;
---

<article class="vc" aria-labelledby={id}>
  <h3 class="vc-aud" id={id}>{audience}</h3>
  <p class="vc-who">{who}</p>
  <div class="vc-body"><slot /></div>
  <p class="vc-take">{takeaway}</p>
</article>

<style>
  .vc { display: flex; flex-direction: column; }
  .vc-aud {
    margin: 0;
    font-family: var(--font-eyebrow);
    font-size: 0.78rem; font-weight: 500;
    letter-spacing: 0.24em; text-transform: uppercase;
  }
  .vc-who {
    margin: 0.5rem 0 0;
    font-family: var(--font-body); font-style: italic;
    color: var(--color-text-muted);
  }
  .vc-body {
    margin-top: 1.3rem;
    font-family: var(--font-body);
    font-size: 1.03rem; line-height: 1.66;
    hyphens: auto;
  }
  .vc-body :global(p) { margin: 0; }
  .vc-body :global(p:first-child::first-letter) {
    float: left;
    font-family: var(--font-display);
    font-size: 3.4em; line-height: 0.82;
    padding: 0.06em 0.03em 0 0;
  }
  .vc-take {
    margin: auto 0 0;
    padding-top: 1.5rem;
    font-family: var(--font-display); font-style: italic;
    font-size: 1.4rem; line-height: 1.25;
    position: relative;
  }
  .vc-take::before {
    content: ""; display: block; width: 3rem; margin-bottom: 0.9rem;
    border-top: 1.5px solid var(--color-text);
  }
</style>
