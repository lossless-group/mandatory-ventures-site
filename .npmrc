# Standalone: never join the parent astro-knots workspace. The site must
# install and deploy from its own repo (Vercel clones only this repo).
ignore-workspace=true

# Flat node_modules for Vite/Astro plugins that expect the classic layout.
shamefully-hoist=true
auto-install-peers=true
strict-peer-dependencies=false

# JSR registry for @lossless-group/lfm (npm alias npm:@jsr/lossless-group__lfm).
# Public registry, no token needed.
@jsr:registry=https://npm.jsr.io
